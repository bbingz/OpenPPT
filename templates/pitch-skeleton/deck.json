{
  "version": "openppt-1",
  "title": "{{DECK_TITLE}}",
  "size": [960, 540],
  "theme": {
    "colors": {
      "primary": "#2563EB",
      "accent": "#F59E0B",
      "text": "#111827",
      "muted": "#6B7280",
      "background": "#FFFFFF",
      "surface": "#F8FAFC"
    }
  },
  "pages": [
    {
      "id": "cover",
      "background": { "type": "solid", "color": "$background" },
      "elements": [
        {
          "id": "cover-bar",
          "type": "shape",
          "bounds": [0, 0, 960, 10],
          "shape": "rect",
          "fill": "$primary"
        },
        {
          "id": "cover-title",
          "type": "text",
          "bounds": [60, 180, 840, 72],
          "text": "{{TITLE}}",
          "fontSize": 36,
          "bold": true,
          "color": "$text",
          "align": "left",
          "valign": "middle"
        },
        {
          "id": "cover-subtitle",
          "type": "text",
          "bounds": [60, 260, 840, 40],
          "text": "{{SUBTITLE}}",
          "fontSize": 18,
          "color": "$muted",
          "align": "left"
        },
        {
          "id": "cover-footer",
          "type": "text",
          "bounds": [60, 480, 840, 28],
          "text": "{{FOOTER}}",
          "fontSize": 12,
          "color": "$muted",
          "align": "left"
        }
      ]
    },
    {
      "id": "toc",
      "background": { "type": "solid", "color": "$surface" },
      "elements": [
        {
          "id": "toc-heading",
          "type": "text",
          "bounds": [60, 40, 840, 48],
          "text": "Agenda",
          "fontSize": 28,
          "bold": true,
          "color": "$primary"
        },
        {
          "id": "toc-list",
          "type": "group",
          "layout": "stack",
          "bounds": [80, 120, 800, 320],
          "gap": 24,
          "children": [
            {
              "id": "toc-item-1",
              "type": "text",
              "height": 40,
              "text": "01  {{TOC_1}}",
              "fontSize": 20,
              "color": "$text"
            },
            {
              "id": "toc-item-2",
              "type": "text",
              "height": 40,
              "text": "02  {{TOC_2}}",
              "fontSize": 20,
              "color": "$text"
            },
            {
              "id": "toc-item-3",
              "type": "text",
              "height": 40,
              "text": "03  {{TOC_3}}",
              "fontSize": 20,
              "color": "$text"
            },
            {
              "id": "toc-item-4",
              "type": "text",
              "height": 40,
              "text": "04  {{TOC_4}}",
              "fontSize": 20,
              "color": "$text"
            }
          ]
        }
      ]
    },
    {
      "id": "body",
      "background": { "type": "solid", "color": "$surface" },
      "elements": [
        {
          "id": "body-heading",
          "type": "text",
          "bounds": [48, 36, 864, 48],
          "text": "{{SECTION_TITLE}}",
          "fontSize": 28,
          "bold": true,
          "color": "$primary"
        },
        {
          "id": "body-panel",
          "type": "group",
          "layout": "layer",
          "bounds": [48, 110, 864, 340],
          "children": [
            {
              "id": "body-card",
              "type": "shape",
              "shape": "roundRect",
              "fill": "$background",
              "lineColor": "$primary",
              "lineWidth": 1
            },
            {
              "id": "body-inner",
              "type": "group",
              "layout": "stack",
              "padding": 24,
              "gap": 16,
              "children": [
                {
                  "id": "body-copy",
                  "type": "text",
                  "flex": 1,
                  "text": "{{BODY}}",
                  "fontSize": 18,
                  "color": "$text",
                  "align": "left",
                  "valign": "top"
                },
                {
                  "id": "body-callout",
                  "type": "text",
                  "height": 40,
                  "text": "{{CALLOUT}}",
                  "fontSize": 14,
                  "bold": true,
                  "color": "$accent"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "final",
      "background": { "type": "solid", "color": "$background" },
      "elements": [
        {
          "id": "final-bar",
          "type": "shape",
          "bounds": [0, 530, 960, 10],
          "shape": "rect",
          "fill": "$primary"
        },
        {
          "id": "final-title",
          "type": "text",
          "bounds": [60, 180, 840, 64],
          "text": "{{CLOSING}}",
          "fontSize": 32,
          "bold": true,
          "color": "$text",
          "align": "center",
          "valign": "middle"
        },
        {
          "id": "final-cta",
          "type": "text",
          "bounds": [60, 280, 840, 40],
          "text": "{{CTA}}",
          "fontSize": 18,
          "color": "$primary",
          "align": "center"
        },
        {
          "id": "final-contact",
          "type": "text",
          "bounds": [60, 420, 840, 40],
          "text": "{{CONTACT}}",
          "fontSize": 14,
          "color": "$muted",
          "align": "center"
        }
      ]
    }
  ]
}

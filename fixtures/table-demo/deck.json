{
  "version": "openppt-1",
  "title": "Table demo",
  "size": [960, 540],
  "theme": {
    "colors": {
      "primary": "#2563EB",
      "text": "#111827",
      "muted": "#6B7280",
      "background": "#FFFFFF",
      "surface": "#F8FAFC"
    }
  },
  "pages": [
    {
      "id": "table-page",
      "background": { "type": "solid", "color": "$background" },
      "elements": [
        {
          "id": "h",
          "type": "text",
          "bounds": [48, 32, 864, 40],
          "text": "OpenPPT tables",
          "fontSize": 26,
          "bold": true,
          "color": "$primary"
        },
        {
          "id": "tbl",
          "type": "table",
          "bounds": [48, 90, 864, 360],
          "header": true,
          "fontSize": 14,
          "borderColor": "$muted",
          "borderWidth": 0.5,
          "colW": [2, 1, 3],
          "rows": [
            ["Feature", "Status", "Notes"],
            ["Charts", "shipped", "bar / line / pie / doughnut / area"],
            ["Tables", "shipped", "string cells or {text, fill, bold}"],
            [
              "Layout",
              "shipped",
              {
                "text": "stack · row · grid · layer",
                "bold": true,
                "color": "$primary"
              }
            ],
            ["Import", "lossy", "text · shape · image · table"]
          ]
        }
      ]
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openppt.dev/schema/openppt-ir-v1.schema.json",
  "title": "OpenPPT Intermediate Representation v1",
  "description": "Agent-friendly declarative deck IR. Absolute bounds in CSS pixels; theme color tokens use $name. Compiles to editable OOXML via open libraries (not proprietary WASM).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "size", "pages"],
  "properties": {
    "version": {
      "type": "string",
      "const": "openppt-1"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "size": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 5376
      },
      "description": "[width, height] in CSS pixels at 96dpi (max 5376 ≈ 56in PowerPoint limit). fontSize is points, not pixels — see docs/IR.md."
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$"
          }
        },
        "fonts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "latin": { "$ref": "#/$defs/fontFamily" },
            "ea": { "$ref": "#/$defs/fontFamily" }
          },
          "description": "Optional script defaults. latin is the Latin typeface fallback; ea, when set, is the East Asian typeface for generated DrawingML. No per-run EA aliases."
        },
        "textStyles": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "additionalProperties": { "$ref": "#/$defs/textStyle" }
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/page" },
          {
            "type": "string",
            "minLength": 1,
            "description": "Relative path to a page file (JSON/YAML) under the project root; expanded at load time."
          }
        ]
      }
    }
  },
  "$defs": {
    "bounds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" },
      "description": "[x, y, width, height] in CSS pixels"
    },
    "color": {
      "type": "string",
      "description": "HEX #RRGGBB / #RRGGBBAA or theme token $name",
      "pattern": "^(\\$[A-Za-z][A-Za-z0-9_-]*|#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8}))$"
    },
    "fontFamily": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9\\u00A0-\\uD7FF\\uE000-\\uFFFD][A-Za-z0-9 '\\-_.()\\u00A0-\\uD7FF\\uE000-\\uFFFD]*$",
      "description": "Typeface name safe for XML 1.0 attributes. Latin/CJK letters, digits, space, apostrophe, hyphen, underscore, period, parentheses. Length uses the existing stringBytes ceiling."
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontSize": { "type": "number", "exclusiveMinimum": 0, "maximum": 4000 },
        "fontFamily": { "$ref": "#/$defs/fontFamily" },
        "color": { "$ref": "#/$defs/color" },
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "align": {
          "type": "string",
          "enum": ["left", "center", "right"]
        },
        "valign": {
          "type": "string",
          "enum": ["top", "middle", "bottom"]
        },
        "lineHeight": { "type": "number", "minimum": 0.5, "maximum": 9.99 },
        "spaceBefore": { "type": "number", "minimum": 0, "maximum": 1584 },
        "spaceAfter": { "type": "number", "minimum": 0, "maximum": 1584 },
        "charSpacing": { "type": "number", "minimum": -100, "maximum": 100 }
      }
    },
    "bullet": {
      "oneOf": [
        { "type": "boolean" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "enum": ["bullet", "number"] },
            "level": { "type": "integer", "minimum": 0, "maximum": 8 },
            "start": { "type": "integer", "minimum": 1, "maximum": 32767 },
            "indent": { "type": "number", "minimum": 0, "maximum": 1584 }
          }
        }
      ]
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/textRun" }
            }
          ]
        },
        "fontSize": { "type": "number", "exclusiveMinimum": 0, "maximum": 4000 },
        "fontFamily": { "$ref": "#/$defs/fontFamily" },
        "color": { "$ref": "#/$defs/color" },
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "align": {
          "type": "string",
          "enum": ["left", "center", "right"]
        },
        "lineHeight": { "type": "number", "minimum": 0.5, "maximum": 9.99 },
        "spaceBefore": { "type": "number", "minimum": 0, "maximum": 1584 },
        "spaceAfter": { "type": "number", "minimum": 0, "maximum": 1584 },
        "charSpacing": { "type": "number", "minimum": -100, "maximum": 100 },
        "bullet": { "$ref": "#/$defs/bullet" }
      }
    },
    "solidFill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "color"],
      "properties": {
        "type": { "const": "solid" },
        "color": { "$ref": "#/$defs/color" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "elements"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "background": { "$ref": "#/$defs/solidFill" },
        "elements": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/textElement" },
              { "$ref": "#/$defs/shapeElement" },
              { "$ref": "#/$defs/imageElement" },
              { "$ref": "#/$defs/chartElement" },
              { "$ref": "#/$defs/tableElement" }
            ]
          }
        }
      }
    },
    "textElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "bounds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "text" },
        "bounds": { "$ref": "#/$defs/bounds" },
        "text": {
          "oneOf": [
            { "type": "string" },
            {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/textRun" },
              "description": "Rich text runs for mixed styles within one box"
            }
          ]
        },
        "fontSize": { "type": "number", "exclusiveMinimum": 0, "maximum": 4000 },
        "fontFamily": { "$ref": "#/$defs/fontFamily" },
        "color": { "$ref": "#/$defs/color" },
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "style": {
          "type": "string",
          "pattern": "^\\$[A-Za-z][A-Za-z0-9_-]*$",
          "description": "Named theme.textStyles reference, e.g. $body. Own-property lookup; no cascade."
        },
        "align": {
          "type": "string",
          "enum": ["left", "center", "right"]
        },
        "valign": {
          "type": "string",
          "enum": ["top", "middle", "bottom"]
        },
        "href": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(https?://|mailto:)[^\\s]+$",
          "description": "Optional hyperlink URL on the text box (http(s) or mailto)"
        },
        "lineHeight": { "type": "number", "minimum": 0.5, "maximum": 9.99 },
        "spaceBefore": { "type": "number", "minimum": 0, "maximum": 1584 },
        "spaceAfter": { "type": "number", "minimum": 0, "maximum": 1584 },
        "charSpacing": { "type": "number", "minimum": -100, "maximum": 100 },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/paragraph" },
          "description": "Explicit paragraphs. Exactly one of text or paragraphs is required."
        }
      }
    },
    "textRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string" },
        "fontSize": { "type": "number", "exclusiveMinimum": 0, "maximum": 4000 },
        "fontFamily": { "$ref": "#/$defs/fontFamily" },
        "color": { "$ref": "#/$defs/color" },
        "bold": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "charSpacing": { "type": "number", "minimum": -100, "maximum": 100 }
      }
    },
    "shapeElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "bounds", "shape"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "shape" },
        "bounds": { "$ref": "#/$defs/bounds" },
        "shape": {
          "type": "string",
          "enum": ["rect", "roundRect", "ellipse"]
        },
        "fill": { "$ref": "#/$defs/color" },
        "lineColor": { "$ref": "#/$defs/color" },
        "lineWidth": { "type": "number", "minimum": 0, "maximum": 1584 }
      }
    },
    "imageElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "bounds", "src"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "image" },
        "bounds": { "$ref": "#/$defs/bounds" },
        "src": {
          "type": "string",
          "minLength": 1,
          "pattern": "^media/(?!\\.{1,2}(?:/|$))[^/\\\\]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\]+)*$",
          "description": "Project-relative path under media/ only. Extension must match content (png/jpeg/gif/webp/svg). No remote URLs."
        },
        "fit": {
          "type": "string",
          "enum": ["cover", "contain", "crop", "fill"],
          "description": "cover (default) fills bounds without stretch; contain letterboxes; fill stretches (legacy)."
        }
      }
    },
    "chartElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "bounds", "chartType", "series"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "chart" },
        "bounds": { "$ref": "#/$defs/bounds" },
        "chartType": {
          "type": "string",
          "enum": ["bar", "line", "pie", "doughnut", "area"]
        },
        "title": { "type": "string" },
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "values"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "labels": {
                "type": "array",
                "items": { "type": "string" }
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "tableCell": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": { "type": "string" },
            "bold": { "type": "boolean" },
            "align": { "type": "string", "enum": ["left", "center", "right"] },
            "color": { "$ref": "#/$defs/color" },
            "fill": { "$ref": "#/$defs/color" },
            "fontSize": { "type": "number", "exclusiveMinimum": 0, "maximum": 4000 }
          }
        }
      ]
    },
    "tableElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "bounds", "rows"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "table" },
        "bounds": { "$ref": "#/$defs/bounds" },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/tableCell" }
          },
          "description": "Row-major cells; strings/numbers or {text, bold?, fill?, color?, align?, fontSize?}"
        },
        "colW": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "description": "Column width fractions (normalized) or absolute shares; equal if omitted"
        },
        "header": {
          "type": "boolean",
          "description": "Style first row as header (bold + primary fill) when cells are plain strings"
        },
        "fontSize": { "type": "number", "exclusiveMinimum": 0, "maximum": 4000 },
        "borderColor": { "$ref": "#/$defs/color" },
        "borderWidth": { "type": "number", "minimum": 0, "maximum": 1584 }
      }
    }
  }
}
